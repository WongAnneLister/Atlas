# Data and generated databases (AGENTS.md §5.3)
data/raw/
# Mixed Flipkart/Philips outputs have unclear redistribution rights (docs/LICENSES.md).
data/processed/
# Derived FAQ/manual/Bitext text inherits the mixed source redistribution limits.
eval/sets/*.jsonl
eval/sets/*.csv
eval/sets/manifest.json
eval/sets/intent_manifest.json
eval/sets/draft_cache.json
eval/runs/*.jsonl
eval/runs/*/items.jsonl
eval/runs/redteam-*/review.csv
eval/runs/redteam-dev.md
eval/runs/redteam-smoke.md
# Smoke artifacts remain local so promotion can start with clean main.
eval/runs/smoke-test-*/
eval/runs/smoke.md
# A release check writes the live run, then collects the candidate in the same process,
# so its run directories must not make the tree dirty. Manifests and metrics are force-added.
eval/runs/index-release-*/
*.sqlite
*.sqlite3
*.db

