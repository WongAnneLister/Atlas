# Copy to .env and fill in. Only the LLM_* variables (plus the provider key) are required.

# LangChain provider name for init_chat_model, e.g. openai, anthropic, deepseek.
LLM_PROVIDER=
# Cheap model for query rewrite and intent classification.
LLM_FAST_MODEL=
# Model for cited answers and refund decisions.
LLM_MAIN_MODEL=
# Provider API key; the variable name depends on the provider package you install.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# Optional provider kwargs as JSON, for example DeepSeek non-thinking mode.
# Keep the single quotes: `source .env` would strip the JSON double quotes without them.
# SUPPORT_AGENT__LLM__MODEL_KWARGS='{"extra_body":{"thinking":{"type":"disabled"}}}'

# Optional: use a different YAML config file instead of configs/default.yaml.
SUPPORT_AGENT_CONFIG=
# Optional: override any config key with SUPPORT_AGENT__<SECTION>__<KEY>, e.g.
# SUPPORT_AGENT__RETRIEVAL__RRF_K=60

# Optional tracing (commit 15). Leave empty to disable. See docs/OBSERVABILITY.md.
# SUPPORT_AGENT__TRACING__ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Optional: Hugging Face token for gated datasets or higher rate limits.
HF_TOKEN=

# State services. Unset ENV (or set local) for SQLite and in-memory checkpoints.
# ENV=dev
# DATABASE_URL=postgresql+psycopg://support:support@localhost:5433/support
# REDIS_URL=redis://localhost:6379/0
# ATLAS_POSTGRES_PORT=5433
# ATLAS_REDIS_PORT=6379

# Optional high-entropy signing key shared across API workers for demo sessions.
SESSION_SECRET=

# Agent console Bearer token for /api/agent/* endpoints. Leave empty to keep the console closed.
# Generate a private value, e.g. `openssl rand -hex 32`. The old public value is refused.
AGENT_TOKEN=

# Public demo daily LLM spend cap in USD (0 = disabled).
DEMO_DAILY_SPEND_CAP_USD=0.0

# Optional public deployment domain for Caddy HTTPS (docker-compose.prod.yml).
ATLAS_DOMAIN=localhost
