# Copy to .env and fill in. Only the LLM_* variables (plus the provider key) are required.

# LangChain provider name for init_chat_model, e.g. openai, anthropic, deepseek.
LLM_PROVIDER=
# Cheap model for query rewrite and intent classification.
LLM_FAST_MODEL=
# Model for cited answers and refund decisions.
LLM_MAIN_MODEL=
# Provider API key; the variable name depends on the provider package you install.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# Optional provider kwargs as JSON, for example DeepSeek non-thinking mode:
# SUPPORT_AGENT__LLM__MODEL_KWARGS={"extra_body":{"thinking":{"type":"disabled"}}}

# Optional: use a different YAML config file instead of configs/default.yaml.
SUPPORT_AGENT_CONFIG=
# Optional: override any config key with SUPPORT_AGENT__<SECTION>__<KEY>, e.g.
# SUPPORT_AGENT__RETRIEVAL__RRF_K=60

# Optional tracing (commit 15). Leave empty to disable.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Optional: Hugging Face token for gated datasets or higher rate limits.
HF_TOKEN=
