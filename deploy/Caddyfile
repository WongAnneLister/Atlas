{$ATLAS_DOMAIN:localhost} {
    encode zstd gzip

    reverse_proxy api:8000 {
        # Flush Server-Sent Events immediately without buffering.
        flush_interval -1
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
}
